{% extends 'base.html.twig' %}

{% block title %}Inscription aux cours — OPP{% endblock %}
{% block season_label %}<span class="opp-season"> — Saison {{ school_year }}</span>{% endblock %}

{% block stylesheets %}
<style>
    .course-card { transition: border-color 0.2s, background-color 0.2s; cursor: pointer; }
    .course-card.in-cart { border-color: #0d6efd !important; background-color: #f0f6ff; }
    .price-struck { text-decoration: line-through; color: #6c757d; font-size: 0.9em; }
    .price-reduced { color: #198754; font-weight: bold; }
    .reduction-badge { font-size: 0.75em; }
    .cart-sidebar { position: sticky; top: 1rem; }
    .don-options .btn-check:checked + .btn { background-color: #0d6efd; color: #fff; }
    .opp-tabs-bar { background: #fff; border-bottom: 1px solid #dee2e6; }
    .opp-tabs-bar .nav-tabs { border-bottom: none; }
    .sidebar-section-title { font-size: 0.85em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: #6c757d; }
</style>
{% endblock %}

{% block tabs %}
<div class="opp-tabs-bar">
    <div class="container">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-annee" type="button">Cours à l'année</button>
            </li>
            {% if products_unite is not empty %}
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-unite" type="button">Cours à l'unité</button>
            </li>
            {% endif %}
        </ul>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="tab-content">

    {# ================================================================== #}
    {# TAB 1: COURS À L'ANNÉE — multi-cart                                #}
    {# ================================================================== #}
    <div class="tab-pane fade show active" id="tab-annee">
        <form method="post" action="{{ path('checkout_create_session') }}" id="checkout-form">
        <div class="row">
            <div class="col-lg-8">
                <h4 class="mb-3">Choisissez vos cours</h4>

                {# Non-Guinguette courses: 2-column grid #}
                <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                    {% for product in products_annee %}
                    {% if not product.is_guinguette %}
                    <div class="col">
                        <div class="card h-100 course-card border" data-slug="{{ product.slug }}">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title mb-1">{{ product.name }}</h6>
                                {% if product.description %}
                                    <p class="card-text text-muted small mb-1">{{ product.description }}</p>
                                {% endif %}
                                {% if product.grants_reduction %}
                                    <span class="badge bg-info reduction-badge mb-2 align-self-start">Donne droit au tarif réduit Guinguette</span>
                                {% endif %}
                                <div class="mt-auto d-flex justify-content-between align-items-end">
                                    <div>
                                        <div class="fw-bold fs-5 course-price"></div>
                                        <small class="text-muted course-installment"></small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary cart-toggle-btn">Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>

                {# Guinguette Orchestra section: 2-column grid #}
                {% set has_guinguette = false %}
                {% for product in products_annee %}
                    {% if product.is_guinguette and not has_guinguette %}
                        {% set has_guinguette = true %}
                        <h5 class="mb-3 text-muted">Guinguette Orchestra</h5>
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                    {% endif %}
                    {% if product.is_guinguette %}
                    <div class="col">
                        <div class="card h-100 course-card border" data-slug="{{ product.slug }}">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title mb-1">{{ product.name }}</h6>
                                <p class="card-text text-muted small mb-1">{{ product.description }}</p>
                                <span class="badge reduction-badge reduction-status mb-1 align-self-start" style="display:none;"></span>
                                <div class="mt-auto d-flex justify-content-between align-items-end">
                                    <div>
                                        <div>
                                            <span class="price-struck guinguette-price-normal" style="display:none;"></span>
                                            <span class="fw-bold fs-5 course-price"></span>
                                        </div>
                                        <small class="text-muted course-installment"></small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary cart-toggle-btn">Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endfor %}
                {% if has_guinguette %}
                        </div>
                {% endif %}
            </div>

            {# ===================== Cart sidebar ===================== #}
            <div class="col-lg-4">
                <div class="cart-sidebar">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Panier</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Rythme de paiement</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-1x" value="1x" autocomplete="off">
                                    <label class="btn btn-outline-primary" for="rythme-1x">1×</label>
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-3x" value="3x" autocomplete="off">
                                    <label class="btn btn-outline-primary" for="rythme-3x">3×</label>
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-10x" value="10x" autocomplete="off" checked>
                                    <label class="btn btn-outline-primary" for="rythme-10x">10×</label>
                                </div>
                            </div>

                            <ul class="list-group list-group-flush mb-3" id="cart-items">
                                <li class="list-group-item text-muted px-0" id="cart-empty">Aucun cours sélectionné</li>
                            </ul>

                            <div id="cart-totals" style="display:none;">
                                <div class="border-top pt-2">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="fw-bold">Total annuel</span>
                                        <div class="text-end">
                                            <span class="price-struck" id="cart-annual-normal" style="display:none;"></span>
                                            <strong id="cart-annual-total"></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===================== Section 1: Email ===================== #}
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">1. Votre email</div>
                            <div class="mb-2">
                                <input type="email" class="form-control" id="email" name="email" placeholder="votre@email.com" required>
                                <div class="form-text">Pour retrouver votre adhésion et vos inscriptions.</div>
                            </div>
                        </div>
                    </div>

                    {# ===================== Section 2: Adhésion & Don ===================== #}
                    <div class="card mt-3" id="section-adhesion-don" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">2. Adhésion & Don</div>
                            <div id="adhesion-section"></div>

                            <div class="mb-0">
                                <label class="form-label fw-bold">Don à l'OPP <small class="text-muted fw-normal">(optionnel)</small></label>
                                <div class="don-options btn-group w-100 mb-2" role="group">
                                    <input type="radio" class="btn-check" name="donation_preset" id="don-0" value="0" autocomplete="off" checked>
                                    <label class="btn btn-outline-secondary btn-sm" for="don-0">Aucun</label>
                                    <input type="radio" class="btn-check" name="donation_preset" id="don-5" value="5" autocomplete="off">
                                    <label class="btn btn-outline-secondary btn-sm" for="don-5">5 €</label>
                                    <input type="radio" class="btn-check" name="donation_preset" id="don-10" value="10" autocomplete="off">
                                    <label class="btn btn-outline-secondary btn-sm" for="don-10">10 €</label>
                                    <input type="radio" class="btn-check" name="donation_preset" id="don-20" value="20" autocomplete="off">
                                    <label class="btn btn-outline-secondary btn-sm" for="don-20">20 €</label>
                                    <input type="radio" class="btn-check" name="donation_preset" id="don-custom" value="custom" autocomplete="off">
                                    <label class="btn btn-outline-secondary btn-sm" for="don-custom">Autre</label>
                                </div>
                                <div class="input-group" style="max-width: 200px; display: none;" id="custom-donation-group">
                                    <input type="number" class="form-control" name="donation_custom_amount" min="1" step="1" placeholder="Montant">
                                    <span class="input-group-text">€</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===================== Section 3: Paiement ===================== #}
                    <div class="card mt-3" id="section-payment" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">3. Paiement</div>
                            <div id="payment-summary" class="mb-3">
                                <div class="d-flex justify-content-between fw-bold mb-1">
                                    <span id="cart-payment-label">Total</span>
                                    <span class="text-nowrap" id="cart-payment-amount"></span>
                                </div>
                                <div class="text-muted" id="cart-schedule" style="display:none;">
                                    <small id="cart-schedule-text"></small>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 btn-lg" id="checkout-btn" disabled>Passer au paiement</button>
                            <p class="text-muted text-center mt-2 mb-0"><small>Paiement sécurisé par Stripe</small></p>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        </form>
    </div>

    {# ================================================================== #}
    {# TAB 2: COURS À L'UNITÉ — simple standalone                         #}
    {# ================================================================== #}
    {% if products_unite is not empty %}
    <div class="tab-pane fade" id="tab-unite">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h4 class="mb-3">Cours à l'unité</h4>

                {% for product in products_unite %}
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.name }}</h5>
                        {% if product.description %}
                            <p class="card-text text-muted">{{ product.description }}</p>
                        {% endif %}
                        {% if product.prices['1x'] is defined %}
                            <div class="fw-bold fs-4 mb-0">{{ product.prices['1x'].amount|format_euros }}</div>
                        {% endif %}
                    </div>
                </div>

                <form method="post" action="{{ path('checkout_create_session') }}" id="form-unite">
                    {% if product.prices['1x'] is defined %}
                        <input type="hidden" name="price_ids[]" value="{{ product.prices['1x'].id }}">
                        <input type="hidden" name="rhythm" value="1x">
                    {% endif %}

                    <div class="card">
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="email-unite" class="form-label fw-bold">Adresse email</label>
                                <input type="email" class="form-control" id="email-unite" name="email" placeholder="votre@email.com" required>
                                <div class="form-text">Pour retrouver votre adhésion et vos inscriptions.</div>
                            </div>

                            <div id="checkout-fields-unite" style="display:none;">
                                <div id="adhesion-section-unite"></div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Don à l'OPP <small class="text-muted fw-normal">(optionnel)</small></label>
                                    <div class="don-options btn-group w-100 mb-2" role="group">
                                        <input type="radio" class="btn-check" name="donation_preset" id="don-unite-0" value="0" autocomplete="off" checked>
                                        <label class="btn btn-outline-secondary btn-sm" for="don-unite-0">Aucun</label>
                                        <input type="radio" class="btn-check" name="donation_preset" id="don-unite-5" value="5" autocomplete="off">
                                        <label class="btn btn-outline-secondary btn-sm" for="don-unite-5">5 €</label>
                                        <input type="radio" class="btn-check" name="donation_preset" id="don-unite-10" value="10" autocomplete="off">
                                        <label class="btn btn-outline-secondary btn-sm" for="don-unite-10">10 €</label>
                                        <input type="radio" class="btn-check" name="donation_preset" id="don-unite-20" value="20" autocomplete="off">
                                        <label class="btn btn-outline-secondary btn-sm" for="don-unite-20">20 €</label>
                                        <input type="radio" class="btn-check" name="donation_preset" id="don-unite-custom" value="custom" autocomplete="off">
                                        <label class="btn btn-outline-secondary btn-sm" for="don-unite-custom">Autre</label>
                                    </div>
                                    <div class="input-group" style="max-width: 200px; display: none;" id="custom-donation-group-unite">
                                        <input type="number" class="form-control" name="donation_custom_amount" min="1" step="1" placeholder="Montant">
                                        <span class="input-group-text">€</span>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 btn-lg" id="checkout-btn-unite">Passer au paiement</button>
                                <p class="text-muted text-center mt-2 mb-0"><small>Paiement sécurisé par Stripe</small></p>
                            </div>

                            <div id="checkout-disabled-unite">
                                <button type="button" class="btn btn-primary w-100 btn-lg" disabled>Passer au paiement</button>
                                <p class="text-muted text-center mt-2 mb-0"><small>Saisissez votre email pour continuer</small></p>
                            </div>
                        </div>
                    </div>
                </form>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    'use strict';

    var PRODUCTS = {{ products_annee_json|raw }};
    var MEMBERSHIP_URL = '{{ path("api_membership") }}';
    var cart = {};
    var currentRhythm = '10x';
    var hasMembership = false;
    var membershipChecked = false;

    var INSTALLMENTS = { '1x': null, '3x': 3, '10x': 10 };

    function formatEuros(cents) {
        var val = cents / 100;
        if (val % 1 === 0) return val.toLocaleString('fr-FR') + ' €';
        return val.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    }

    function getProductBySlug(slug) {
        for (var i = 0; i < PRODUCTS.length; i++) {
            if (PRODUCTS[i].slug === slug) return PRODUCTS[i];
        }
        return null;
    }

    function cartHasReductionEligible() {
        for (var slug in cart) {
            var p = getProductBySlug(slug);
            if (p && p.grants_reduction) return true;
        }
        return false;
    }

    function getEffectivePrice(product, rhythm) {
        var eligible = product.is_guinguette && cartHasReductionEligible();
        var reducedKey = rhythm + '_reduc';
        if (eligible && product.prices[reducedKey]) {
            return { price: product.prices[reducedKey], reduced: true, normalPrice: product.prices[rhythm] };
        }
        return { price: product.prices[rhythm], reduced: false, normalPrice: null };
    }

    function getAnnualAmount(priceInfo) {
        if (!priceInfo || !priceInfo.price) return 0;
        var inst = INSTALLMENTS[currentRhythm];
        if (inst) return priceInfo.price.amount * inst;
        return priceInfo.price.amount;
    }

    function getPeriodSuffix() {
        return currentRhythm === '3x' ? ' / trim.' : ' / mois';
    }

    function getAdhesionAmountCents() {
        var el = document.querySelector('input[name="adhesion_amount"]');
        if (!el) return 0;
        return Math.max(0, parseInt(el.value, 10) || 0) * 100;
    }

    function getDonAmountCents() {
        var checked = document.querySelector('#checkout-form input[name="donation_preset"]:checked');
        if (!checked) return 0;
        if (checked.value === 'custom') {
            var custom = document.querySelector('#checkout-form input[name="donation_custom_amount"]');
            return Math.max(0, parseInt(custom ? custom.value : '0', 10) || 0) * 100;
        }
        return Math.max(0, parseInt(checked.value, 10) || 0) * 100;
    }

    function updateCardDisplay(card, product) {
        var rhythm = currentRhythm;
        var eff = getEffectivePrice(product, rhythm);
        var priceEl = card.querySelector('.course-price');
        var installmentEl = card.querySelector('.course-installment');
        var struckEl = card.querySelector('.guinguette-price-normal');
        var statusEl = card.querySelector('.reduction-status');

        if (eff.price) {
            var annual = getAnnualAmount(eff);
            priceEl.textContent = formatEuros(annual) + ' / an';
        } else {
            priceEl.textContent = '';
        }

        if (installmentEl) {
            var inst = INSTALLMENTS[rhythm];
            if (eff.price && inst) {
                var suffix = getPeriodSuffix();
                if (eff.reduced && eff.normalPrice) {
                    installmentEl.innerHTML = '<span class="price-struck">' + formatEuros(eff.normalPrice.amount) + suffix + '</span> ' + formatEuros(eff.price.amount) + suffix;
                } else {
                    installmentEl.textContent = formatEuros(eff.price.amount) + suffix;
                }
            } else {
                installmentEl.innerHTML = '';
            }
        }

        if (product.is_guinguette) {
            if (struckEl) {
                if (eff.reduced && eff.normalPrice) {
                    var normalAnnual = INSTALLMENTS[rhythm] ? eff.normalPrice.amount * INSTALLMENTS[rhythm] : eff.normalPrice.amount;
                    struckEl.textContent = formatEuros(normalAnnual) + ' / an';
                    struckEl.style.display = '';
                } else {
                    struckEl.style.display = 'none';
                }
            }
            if (statusEl) {
                var eligible = cartHasReductionEligible();
                if (eff.reduced) {
                    statusEl.className = 'badge bg-success reduction-badge reduction-status mb-2 align-self-start';
                    statusEl.textContent = 'Tarif réduit appliqué';
                    statusEl.style.display = '';
                } else if (eligible) {
                    statusEl.style.display = 'none';
                } else if (product.reduced_by.length > 0) {
                    statusEl.className = 'badge bg-warning text-dark reduction-badge reduction-status mb-2 align-self-start';
                    statusEl.textContent = 'Tarif réduit appliquable';
                    statusEl.style.display = '';
                } else {
                    statusEl.style.display = 'none';
                }
            }
        }

        var inCart = cart[product.slug] === true;
        var btn = card.querySelector('.cart-toggle-btn');
        card.classList.toggle('in-cart', inCart);
        card.classList.toggle('border-2', inCart);
        if (btn) {
            if (inCart) {
                btn.textContent = 'Retirer';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-outline-danger');
            } else {
                btn.textContent = 'Ajouter';
                btn.classList.remove('btn-outline-danger');
                btn.classList.add('btn-outline-primary');
            }
        }
    }

    function updateCart() {
        var cartItemsEl = document.getElementById('cart-items');
        var cartEmptyEl = document.getElementById('cart-empty');
        var cartTotals = document.getElementById('cart-totals');
        var items = [];

        cartItemsEl.querySelectorAll('.cart-line').forEach(function(el) { el.remove(); });

        var totalAnnual = 0;
        var totalNormalAnnual = 0;
        var inst = INSTALLMENTS[currentRhythm];
        var suffix = getPeriodSuffix();

        for (var slug in cart) {
            var product = getProductBySlug(slug);
            if (!product) continue;

            var eff = getEffectivePrice(product, currentRhythm);
            if (!eff.price) continue;

            var annual = getAnnualAmount(eff);
            totalAnnual += annual;

            if (eff.reduced && eff.normalPrice) {
                var normalAnnual = inst ? eff.normalPrice.amount * inst : eff.normalPrice.amount;
                totalNormalAnnual += normalAnnual;
            } else {
                totalNormalAnnual += annual;
            }

            var li = document.createElement('li');
            li.className = 'list-group-item px-0 cart-line';
            li.innerHTML = '<div class="d-flex justify-content-between"><span>' + product.name + '</span><strong class="text-nowrap ms-2">' + formatEuros(annual) + ' / an</strong></div>' +
                (inst ? '<div class="text-end"><small class="text-muted">' + formatEuros(eff.price.amount) + suffix + '</small></div>' : '');

            cartItemsEl.appendChild(li);
            items.push({ slug: slug, priceId: eff.price.id });
        }

        var adhesionCents = getAdhesionAmountCents();
        var donCents = getDonAmountCents();

        if (adhesionCents > 0) {
            var liAdh = document.createElement('li');
            liAdh.className = 'list-group-item px-0 cart-line';
            liAdh.innerHTML = '<div class="d-flex justify-content-between"><span>Adhésion {{ school_year }}</span><strong class="text-nowrap ms-2">' + formatEuros(adhesionCents) + '</strong></div>';
            cartItemsEl.appendChild(liAdh);
            totalAnnual += adhesionCents;
            totalNormalAnnual += adhesionCents;
        }

        if (donCents > 0) {
            var liDon = document.createElement('li');
            liDon.className = 'list-group-item px-0 cart-line';
            liDon.innerHTML = '<div class="d-flex justify-content-between"><span>Don à l\'OPP</span><strong class="text-nowrap ms-2">' + formatEuros(donCents) + '</strong></div>';
            cartItemsEl.appendChild(liDon);
            totalAnnual += donCents;
            totalNormalAnnual += donCents;
        }

        var hasItems = items.length > 0;
        cartEmptyEl.style.display = hasItems ? 'none' : '';
        cartTotals.style.display = hasItems ? '' : 'none';

        var sectionPayment = document.getElementById('section-payment');
        sectionPayment.style.display = (hasItems && membershipChecked) ? '' : 'none';

        if (hasItems) {
            var normalEl = document.getElementById('cart-annual-normal');
            var totalEl = document.getElementById('cart-annual-total');
            if (totalNormalAnnual > totalAnnual) {
                normalEl.textContent = formatEuros(totalNormalAnnual);
                normalEl.style.display = '';
                totalEl.textContent = formatEuros(totalAnnual);
            } else {
                normalEl.style.display = 'none';
                totalEl.textContent = formatEuros(totalAnnual);
            }

            var paymentLabel = document.getElementById('cart-payment-label');
            var paymentAmount = document.getElementById('cart-payment-amount');
            var scheduleEl = document.getElementById('cart-schedule');
            var scheduleText = document.getElementById('cart-schedule-text');

            if (inst) {
                var perPaymentCourses = 0;
                for (var slug in cart) {
                    var p = getProductBySlug(slug);
                    if (!p) continue;
                    var e = getEffectivePrice(p, currentRhythm);
                    if (e.price) perPaymentCourses += e.price.amount;
                }
                var firstPayment = perPaymentCourses + adhesionCents + donCents;
                paymentLabel.innerHTML = '1<sup>er</sup> paiement aujourd\'hui';
                paymentAmount.textContent = formatEuros(firstPayment);
                scheduleText.textContent = 'puis ' + (inst - 1) + ' paiements de ' + formatEuros(perPaymentCourses) + (currentRhythm === '3x' ? ' / trimestre' : ' / mois');
                scheduleEl.style.display = '';
            } else {
                paymentLabel.textContent = 'Total';
                paymentAmount.textContent = formatEuros(totalAnnual);
                scheduleEl.style.display = 'none';
            }
        }

        document.getElementById('checkout-form').querySelectorAll('input[name="price_ids[]"]').forEach(function(el) { el.remove(); });
        items.forEach(function(item) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'price_ids[]';
            input.value = item.priceId;
            document.getElementById('checkout-form').appendChild(input);
        });

        var btn = document.getElementById('checkout-btn');
        btn.disabled = !hasItems || !membershipChecked;
    }

    function updateAllCards() {
        document.querySelectorAll('.course-card[data-slug]').forEach(function(card) {
            var slug = card.dataset.slug;
            var product = getProductBySlug(slug);
            if (product) updateCardDisplay(card, product);
        });
        updateCart();
    }

    document.querySelectorAll('.course-card[data-slug]').forEach(function(card) {
        var btn = card.querySelector('.cart-toggle-btn');
        if (btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                var slug = card.dataset.slug;
                if (cart[slug]) {
                    delete cart[slug];
                } else {
                    cart[slug] = true;
                }
                updateAllCards();
            });
        }
    });

    document.querySelectorAll('input[name="rhythm"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            currentRhythm = this.value;
            updateAllCards();
        });
    });

    var emailDebounce = null;
    function checkMembership(email, suffix) {
        if (suffix === '-unite') {
            var fieldsEl = document.getElementById('checkout-fields-unite');
            var disabledEl = document.getElementById('checkout-disabled-unite');
            var adhesionEl = document.getElementById('adhesion-section-unite');

            if (!email || !email.includes('@')) {
                fieldsEl.style.display = 'none';
                disabledEl.style.display = '';
                return;
            }

            fetch(MEMBERSHIP_URL + '?email=' + encodeURIComponent(email))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.has_membership) {
                        adhesionEl.innerHTML = '<div class="alert alert-success py-2 mb-3"><small>✓ Adhésion {{ school_year }} déjà validée</small></div><input type="hidden" name="adhesion_amount" value="0">';
                    } else {
                        adhesionEl.innerHTML = '<div class="mb-3"><label class="form-label fw-bold">Adhésion {{ school_year }} <span class="text-danger">*</span></label><div class="input-group" style="max-width:200px;"><input type="number" class="form-control" name="adhesion_amount" min="1" step="1" value="10" required><span class="input-group-text">€</span></div><div class="form-text">Prix libre, minimum 1 €. Obligatoire pour s\'inscrire.</div></div>';
                    }
                    fieldsEl.style.display = '';
                    disabledEl.style.display = 'none';
                });
            return;
        }

        var sectionAdhDon = document.getElementById('section-adhesion-don');
        var adhesionEl = document.getElementById('adhesion-section');

        if (!email || !email.includes('@')) {
            sectionAdhDon.style.display = 'none';
            document.getElementById('section-payment').style.display = 'none';
            membershipChecked = false;
            updateCart();
            return;
        }

        fetch(MEMBERSHIP_URL + '?email=' + encodeURIComponent(email))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                hasMembership = data.has_membership;
                membershipChecked = true;

                if (hasMembership) {
                    adhesionEl.innerHTML = '<div class="alert alert-success py-2 mb-3"><small>✓ Adhésion {{ school_year }} déjà validée</small></div><input type="hidden" name="adhesion_amount" value="0">';
                } else {
                    adhesionEl.innerHTML = '<div class="mb-3"><label class="form-label fw-bold">Adhésion {{ school_year }} <span class="text-danger">*</span></label><div class="input-group" style="max-width:200px;"><input type="number" class="form-control" name="adhesion_amount" min="1" step="1" value="10" required><span class="input-group-text">€</span></div><div class="form-text">Prix libre, minimum 1 €. Obligatoire pour s\'inscrire.</div></div>';
                    var adhInput = adhesionEl.querySelector('input[name="adhesion_amount"]');
                    if (adhInput) adhInput.addEventListener('input', updateCart);
                }

                sectionAdhDon.style.display = '';
                updateCart();
            });
    }

    document.getElementById('email').addEventListener('input', function() {
        var email = this.value;
        clearTimeout(emailDebounce);
        emailDebounce = setTimeout(function() { checkMembership(email, ''); }, 500);
    });

    var emailUnite = document.getElementById('email-unite');
    if (emailUnite) {
        var debounceUnite = null;
        emailUnite.addEventListener('input', function() {
            var email = this.value;
            clearTimeout(debounceUnite);
            debounceUnite = setTimeout(function() { checkMembership(email, '-unite'); }, 500);
        });
    }

    document.querySelectorAll('#checkout-form input[name="donation_preset"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var group = document.getElementById('custom-donation-group');
            if (group) group.style.display = this.value === 'custom' ? '' : 'none';
            updateCart();
        });
    });

    var customDonInput = document.querySelector('#custom-donation-group input[name="donation_custom_amount"]');
    if (customDonInput) customDonInput.addEventListener('input', updateCart);

    document.querySelectorAll('#form-unite input[name="donation_preset"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var group = document.getElementById('custom-donation-group-unite');
            if (group) group.style.display = this.value === 'custom' ? '' : 'none';
        });
    });

    updateAllCards();
})();
</script>
{% endblock %}
