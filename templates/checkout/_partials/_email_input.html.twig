{# suffix: string (e.g. '', '-unite', '-soutien') to generate unique IDs #}
<div class="mb-3">
    <label for="email{{ suffix }}" class="form-label fw-bold">Adresse email</label>
    <input type="email" class="form-control" id="email{{ suffix }}" name="email" placeholder="votre@email.com" required>
    <div class="form-text">Pour retrouver votre adhésion et vos inscriptions.</div>
</div>
