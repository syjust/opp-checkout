{% extends 'base.html.twig' %}

{% block title %}Inscription aux cours — OPP{% endblock %}

{% block body %}
<h1 class="mb-4">Inscription aux cours et ateliers de musique</h1>
<p class="text-muted mb-4">Tarifs {{ school_year }} — Choisissez votre cours puis votre rythme de paiement.</p>

<ul class="nav nav-tabs mb-4" role="tablist">
    {% for cat_key, cat_label in categories %}
        <li class="nav-item" role="presentation">
            <button class="nav-link{% if loop.first %} active{% endif %}"
                    id="tab-{{ cat_key }}"
                    data-bs-toggle="tab"
                    data-bs-target="#pane-{{ cat_key }}"
                    type="button"
                    role="tab">
                {{ cat_label }}
            </button>
        </li>
    {% endfor %}
</ul>

<div class="tab-content">
    {% for cat_key, cat_label in categories %}
        <div class="tab-pane fade{% if loop.first %} show active{% endif %}"
             id="pane-{{ cat_key }}"
             role="tabpanel">

            {% set cat_products = products_by_category[cat_key] | default([]) %}

            {% if cat_products is empty %}
                <p class="text-muted">Aucun produit disponible dans cette catégorie pour le moment.</p>
            {% else %}
                <div class="row g-4">
                    {% for item in cat_products %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">{{ item.product.name }}</h5>
                                    {% if item.product.description %}
                                        <p class="card-text text-muted small">{{ item.product.description }}</p>
                                    {% endif %}

                                    <div class="d-grid gap-2 mt-3">
                                        {% for price in item.prices %}
                                            {% set label = price_label(price) %}
                                            <a href="{{ path('checkout_email', {
                                                price_id: price.id,
                                                lookup_key: price.lookup_key | default(''),
                                            }) }}"
                                               class="btn btn-outline-primary btn-sm">
                                                {{ label }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>
{% endblock %}
