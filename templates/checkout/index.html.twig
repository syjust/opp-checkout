{% extends 'base.html.twig' %}

{% block title %}Inscription aux cours — OPP{% endblock %}
{% block season_label %}<span class="opp-season"> — Saison {{ school_year }}</span>{% endblock %}

{% block stylesheets %}
<style>
    .course-card { transition: border-color 0.2s, background-color 0.2s; cursor: pointer; }
    .course-card.in-cart { border-color: #0d6efd !important; background-color: #f0f6ff; }
    .price-struck { text-decoration: line-through; color: #6c757d; font-size: 0.9em; }
    .price-reduced { color: #198754; font-weight: bold; }
    .reduction-badge { font-size: 0.75em; }
    .cart-sidebar { position: sticky; top: 1rem; }
    .don-options .btn-check:checked + .btn { background-color: #0d6efd; color: #fff; }
    .opp-tabs-bar { background: #fff; border-bottom: 1px solid #dee2e6; }
    .opp-tabs-bar .nav-tabs { border-bottom: none; }
    .sidebar-section-title { font-size: 0.85em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: #6c757d; }
</style>
{% endblock %}

{% block tabs %}
<div class="opp-tabs-bar">
    <div class="container">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-annee" type="button">Cours à l'année</button>
            </li>
            {% if products_unite is not empty %}
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-unite" type="button">Cours à l'unité</button>
            </li>
            {% endif %}
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-soutien" type="button">Adhésion & Dons</button>
            </li>
        </ul>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="tab-content">

    {# ================================================================== #}
    {# TAB 1: COURS À L'ANNÉE — multi-cart                                #}
    {# ================================================================== #}
    <div class="tab-pane fade show active" id="tab-annee">
        <form method="post" action="{{ path('checkout_create_session') }}" id="checkout-form">
        <div class="row">
            <div class="col-lg-8">
                <h4 class="mb-3">Choisissez vos cours</h4>

                {# Non-Guinguette courses: 2-column grid #}
                <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                    {% for product in products_annee %}
                    {% if not product.is_guinguette %}
                    <div class="col">
                        <div class="card h-100 course-card border" data-slug="{{ product.slug }}">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title mb-1">{{ product.name }}</h6>
                                {% if product.description %}
                                    <p class="card-text text-muted small mb-1">{{ product.description }}</p>
                                {% endif %}
                                {% if product.grants_reduction %}
                                    <span class="badge bg-info reduction-badge mb-2 align-self-start">Donne droit au tarif réduit Guinguette</span>
                                {% endif %}
                                <div class="mt-auto d-flex justify-content-between align-items-end">
                                    <div>
                                        <div class="fw-bold fs-5 course-price"></div>
                                        <small class="text-muted course-installment"></small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary cart-toggle-btn">Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>

                {# Guinguette Orchestra section: 2-column grid #}
                {% set has_guinguette = false %}
                {% for product in products_annee %}
                    {% if product.is_guinguette and not has_guinguette %}
                        {% set has_guinguette = true %}
                        <h5 class="mb-3 text-muted">Guinguette Orchestra</h5>
                        <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
                    {% endif %}
                    {% if product.is_guinguette %}
                    <div class="col">
                        <div class="card h-100 course-card border" data-slug="{{ product.slug }}">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title mb-1">{{ product.name }}</h6>
                                <p class="card-text text-muted small mb-1">{{ product.description }}</p>
                                <span class="badge reduction-badge reduction-status mb-1 align-self-start" style="display:none;"></span>
                                <div class="mt-auto d-flex justify-content-between align-items-end">
                                    <div>
                                        <div>
                                            <span class="price-struck guinguette-price-normal" style="display:none;"></span>
                                            <span class="fw-bold fs-5 course-price"></span>
                                        </div>
                                        <small class="text-muted course-installment"></small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary cart-toggle-btn">Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                {% endfor %}
                {% if has_guinguette %}
                        </div>
                {% endif %}
                <p class="text-muted small mt-2 mb-0" id="installment-footnote" style="display:none;"></p>
            </div>

            {# ===================== Cart sidebar ===================== #}
            <div class="col-lg-4">
                <div class="cart-sidebar">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Panier</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Rythme de paiement</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-1x" value="1x" autocomplete="off">
                                    <label class="btn btn-outline-primary" for="rythme-1x">1×</label>
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-3x" value="3x" autocomplete="off">
                                    <label class="btn btn-outline-primary" for="rythme-3x">3×</label>
                                    <input type="radio" class="btn-check" name="rhythm" id="rythme-10x" value="10x" autocomplete="off" checked>
                                    <label class="btn btn-outline-primary" for="rythme-10x">10×</label>
                                </div>
                            </div>

                            <ul class="list-group list-group-flush mb-3" id="cart-items">
                                <li class="list-group-item text-muted px-0" id="cart-empty">Aucun cours sélectionné</li>
                            </ul>

                            <div id="cart-totals" style="display:none;">
                                <div class="border-top pt-2">
                                    <div class="d-flex justify-content-between align-items-baseline">
                                        <span class="fw-bold" id="cart-total-label">Total aujourd'hui</span>
                                        <strong id="cart-total-today"></strong>
                                    </div>
                                    <div class="text-muted" id="cart-total-schedule" style="display:none;">
                                        <small id="cart-total-schedule-text"></small>
                                    </div>
                                    <div class="text-muted" id="cart-total-annual-row" style="display:none;">
                                        <small>
                                            Total annuel
                                            <span class="price-struck" id="cart-annual-normal" style="display:none;"></span>
                                            <span id="cart-annual-total"></span>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===================== Section 1: Email ===================== #}
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">1. Votre email</div>
                            {{ include('checkout/_partials/_email_input.html.twig', { suffix: '' }) }}
                        </div>
                    </div>

                    {# ===================== Section 2: Adhésion & Don ===================== #}
                    <div class="card mt-3" id="section-adhesion-don" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">2. Adhésion & Don</div>
                            {{ include('checkout/_partials/_adhesion_don.html.twig', { suffix: '', school_year: school_year }) }}
                        </div>
                    </div>

                    {# ===================== Section 3: Paiement ===================== #}
                    <div class="card mt-3" id="section-payment" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">3. Paiement</div>
                            <div id="payment-summary" class="mb-3">
                                <div class="d-flex justify-content-between fw-bold mb-1">
                                    <span id="cart-payment-label">Total</span>
                                    <span class="text-nowrap" id="cart-payment-amount"></span>
                                </div>
                                <div class="text-muted" id="cart-schedule" style="display:none;">
                                    <small id="cart-schedule-text"></small>
                                </div>
                            </div>
                            {{ include('checkout/_partials/_checkout_button.html.twig', { id: 'checkout-btn', disabled: true }) }}
                        </div>
                    </div>

                </div>
            </div>
        </div>
        </form>
    </div>

    {# ================================================================== #}
    {# TAB 2: COURS À L'UNITÉ — simple standalone                         #}
    {# ================================================================== #}
    {% if products_unite is not empty %}
    <div class="tab-pane fade" id="tab-unite">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h4 class="mb-3">Cours à l'unité</h4>

                <form method="post" action="{{ path('checkout_create_session') }}" id="form-unite">
                    <input type="hidden" name="rhythm" value="1x">

                    {% for product in products_unite %}
                    {% if product.prices['1x'] is defined %}
                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="card-title">{{ product.name }}</h5>
                            {% if product.description %}
                                <p class="card-text text-muted">{{ product.description }}</p>
                            {% endif %}
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-bold fs-4 mb-0">{{ product.prices['1x'].amount|format_euros }}</div>
                                <div class="d-flex align-items-center gap-2">
                                    <label class="form-label mb-0 text-muted small" for="qty-{{ product.slug }}">Quantité</label>
                                    <select class="form-select form-select-sm unite-qty-select" style="width: 5rem;"
                                            id="qty-{{ product.slug }}"
                                            name="quantities[{{ product.prices['1x'].id }}]"
                                            data-price-id="{{ product.prices['1x'].id }}"
                                            data-unit-price="{{ product.prices['1x'].amount }}">
                                        {% for i in 1..20 %}
                                            <option value="{{ i }}">{{ i }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                            <div class="text-muted small mt-1 unite-subtotal" data-for="{{ product.slug }}">
                                Sous-total : {{ product.prices['1x'].amount|format_euros }}
                            </div>
                            <input type="hidden" name="price_ids[]" value="{{ product.prices['1x'].id }}">
                        </div>
                    </div>
                    {% endif %}
                    {% endfor %}

                    <div class="card">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">1. Votre email</div>
                            {{ include('checkout/_partials/_email_input.html.twig', { suffix: '-unite' }) }}
                        </div>
                    </div>

                    <div class="card mt-3" id="section-adhesion-don-unite" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">2. Adhésion & Don</div>
                            {{ include('checkout/_partials/_adhesion_don.html.twig', { suffix: '-unite', school_year: school_year }) }}
                        </div>
                    </div>

                    <div class="card mt-3" id="section-payment-unite" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">3. Paiement</div>
                            <div class="d-flex justify-content-between fw-bold mb-1">
                                <span>Total</span>
                                <span class="text-nowrap" id="unite-total"></span>
                            </div>
                            {{ include('checkout/_partials/_checkout_button.html.twig', { id: 'checkout-btn-unite' }) }}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% endif %}

    {# ================================================================== #}
    {# TAB 3: ADHÉSION & DONS — soutien sans cours                        #}
    {# ================================================================== #}
    <div class="tab-pane fade" id="tab-soutien">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h4 class="mb-3">Adhérez et soutenez l'Oreille Presque Parfaite</h4>
                <p class="text-muted mb-4">Prix libre à partir de 1€</p>

                <form method="post" action="{{ path('checkout_create_session') }}" id="form-soutien">
                    <input type="hidden" name="rhythm" value="1x">

                    <div class="card">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">1. Votre email</div>
                            {{ include('checkout/_partials/_email_input.html.twig', { suffix: '-soutien' }) }}
                        </div>
                    </div>

                    <div class="card mt-3" id="section-adhesion-don-soutien" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">2. Adhésion & Don</div>
                            {{ include('checkout/_partials/_adhesion_don.html.twig', { suffix: '-soutien', school_year: school_year }) }}
                        </div>
                    </div>

                    <div class="card mt-3" id="section-payment-soutien" style="display:none;">
                        <div class="card-body">
                            <div class="sidebar-section-title mb-2">3. Paiement</div>
                            <div class="d-flex justify-content-between fw-bold mb-1">
                                <span>Total</span>
                                <span class="text-nowrap" id="soutien-total"></span>
                            </div>
                            {{ include('checkout/_partials/_checkout_button.html.twig', { id: 'checkout-btn-soutien' }) }}
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/opp-utils.js') }}"></script>
<script src="{{ asset('js/opp-membership.js') }}"></script>
<script src="{{ asset('js/opp-donation.js') }}"></script>
<script src="{{ asset('js/opp-cart.js') }}"></script>
<script src="{{ asset('js/opp-tabs.js') }}"></script>
<script>
(function() {
    'use strict';

    OPP._membershipUrl = '{{ path("api_membership") }}';
    OPP._schoolYear = '{{ school_year }}';
    OPP._hasMembership = false;
    OPP._membershipChecked = false;
    OPP._hasReductionFromPurchase = false;

    OPP.initCart({{ products_annee_json|raw }});

    OPP.setupEmailDebounce('email', '');
    OPP.setupEmailDebounce('email-unite', '-unite');
    OPP.setupEmailDebounce('email-soutien', '-soutien');

    OPP.setupDonationPresets('#checkout-form', '', OPP.updateCart);

    function getFormAdhesionCents(formSelector) {
        var el = document.querySelector(formSelector + ' input[name="adhesion_amount"]');
        if (!el) return 0;
        return Math.max(0, parseInt(el.value, 10) || 0) * 100;
    }

    function getFormDonCents(formSelector) {
        var checked = document.querySelector(formSelector + ' input[name="donation_preset"]:checked');
        if (!checked) return 0;
        if (checked.value === 'custom') {
            var custom = document.querySelector(formSelector + ' input[name="donation_custom_amount"]');
            return Math.max(0, parseInt(custom ? custom.value : '0', 10) || 0) * 100;
        }
        return Math.max(0, parseInt(checked.value, 10) || 0) * 100;
    }

    function updateTotalUnite() {
        var total = 0;
        document.querySelectorAll('.unite-qty-select').forEach(function(select) {
            var unitPrice = parseInt(select.dataset.unitPrice, 10);
            var qty = parseInt(select.value, 10);
            total += unitPrice * qty;
        });
        total += getFormAdhesionCents('#form-unite');
        total += getFormDonCents('#form-unite');
        var el = document.getElementById('unite-total');
        if (el) el.textContent = OPP.formatEuros(total);
    }
    OPP.updateTotal_unite = updateTotalUnite;

    function updateTotalSoutien() {
        var total = getFormAdhesionCents('#form-soutien') + getFormDonCents('#form-soutien');
        var el = document.getElementById('soutien-total');
        if (el) el.textContent = OPP.formatEuros(total);
    }
    OPP.updateTotal_soutien = updateTotalSoutien;

    document.querySelectorAll('.unite-qty-select').forEach(function(select) {
        select.addEventListener('change', function() {
            var unitPrice = parseInt(select.dataset.unitPrice, 10);
            var qty = parseInt(select.value, 10);
            var slug = select.id.replace('qty-', '');
            var subtotalEl = document.querySelector('.unite-subtotal[data-for="' + slug + '"]');
            if (subtotalEl) {
                subtotalEl.textContent = 'Sous-total : ' + OPP.formatEuros(unitPrice * qty);
            }
            updateTotalUnite();
        });
    });

    OPP.setupDonationPresets('#form-unite', '-unite', updateTotalUnite);
    OPP.setupDonationPresets('#form-soutien', '-soutien', updateTotalSoutien);

    OPP.initTabs();
})();
</script>
{% endblock %}
