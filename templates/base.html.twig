<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}OPP — Inscription{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/favicon.png') }}">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
        <style>
            .opp-header {
                position: relative;
                width: 100%;
                overflow: hidden;
                background: #fff;
            }
            .opp-header img {
                width: 100%;
                height: auto;
                display: block;
            }
            .opp-header-overlay {
                position: absolute;
                right: 6%;
                top: 30%;
                transform: translateY(-50%);
                text-align: right;
            }
            .opp-header-overlay .opp-name {
                font-family: Georgia, 'Times New Roman', serif;
                font-style: italic;
                font-weight: bold;
                font-size: clamp(1.2rem, 2.8vw, 2rem);
                color: #1a7a7a;
                margin: 0;
                line-height: 1.15;
            }
            .opp-header-overlay .opp-title {
                font-weight: 700;
                font-size: clamp(1.1rem, 2.6vw, 1.8rem);
                color: #e8912d;
                margin: 0.15em 0 0;
                line-height: 1.2;
            }
            .opp-header-overlay .opp-season {
                font-size: clamp(0.8rem, 1.6vw, 1rem);
                color: #e8912d;
                margin: 0.15em 0 0;
            }
            @media (max-width: 767px) {
                .opp-header img { display: none; }
                .opp-header-overlay {
                    position: static;
                    transform: none;
                    text-align: center;
                    padding: 0.8rem 1rem 0.4rem;
                }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-light">
        {% block header %}
        <div class="container opp-header">
            <img src="{{ asset('img/opp-header.png') }}" alt="">
            <div class="opp-header-overlay">
                <p class="opp-name">L'Oreille Presque Parfaite</p>
                <p>
                    <span class="opp-title">Inscriptions</span>
                    {% block season_label %}{% endblock %}
                </p>
            </div>
        </div>
        {% endblock %}

        {% block tabs %}{% endblock %}

        <div class="container py-4">
            {% block body %}{% endblock %}
        </div>

        <footer class="container text-muted py-4 mt-5 border-top">
            <div class="d-flex justify-content-between">
                <small>L'Oreille Presque Parfaite (OPP) — Association loi 1901</small>
                <small>{{ app_version() }}</small>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
